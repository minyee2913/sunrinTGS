{
  "rules": {
    "hp": {
      "meta": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.child('hostId').exists() || data.child('hostId').val() === auth.uid || !root.child('hp/lobby/' + data.child('hostId').val() + '/conn').exists())"
      },
      "lobby": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('hp/meta/hostId').val() === auth.uid)",
          ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 12",
          "name": { ".validate": true },
          "joinedAt": { ".validate": "newData.isNumber()" },
          "inst": { ".validate": "newData.isString()" },
          "conn": { "$inst": { ".validate": "newData.val() === true" } },
          "char": {
            "c": { ".validate": "newData.isNumber()" },
            "hair": { ".validate": "newData.isNumber()" },
            "face": { ".validate": "newData.isNumber()" },
            "acc": { ".validate": "newData.isNumber()" },
            "$x": { ".validate": false }
          },
          "$other": { ".validate": false }
        }
      },
      "pub": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('hp/meta/hostId').val() === auth.uid"
      },
      "priv": {
        ".write": "auth != null && root.child('hp/meta/hostId').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('hp/meta/hostId').val() === auth.uid)"
        }
      },
      "req": {
        ".read": "auth != null && root.child('hp/meta/hostId').val() === auth.uid",
        ".write": "auth != null && root.child('hp/meta/hostId').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$reqId": {
            ".write": "auth != null && (auth.uid === $uid || root.child('hp/meta/hostId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['gameId', 'type']) && newData.child('type').isString()"
          }
        }
      },
      "vote": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('hp/meta/hostId').val() === auth.uid || (!newData.exists() && data.child('by').val() === auth.uid) || ((!data.exists() || now - data.child('at').val() > 30000) && newData.child('by').val() === auth.uid && root.child('hp/lobby/' + auth.uid + '/conn').exists()))",
        "by": { ".validate": "newData.isString()" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 10000" },
        "v": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('by').exists() && root.child('hp/lobby/' + auth.uid + '/conn').exists()",
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": { ".validate": false }
      },
      "hs": {
        ".read": "auth != null && root.child('hp/meta/hostId').val() === auth.uid",
        ".write": "auth != null && root.child('hp/meta/hostId').val() === auth.uid"
      }
    }
  }
}
